# Copy to .env and fill in (local only). On a host, set these in its dashboard instead. .env is git-ignored.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Port to listen on. Hosting platforms (Render/Railway/Heroku) set PORT themselves.
# PORT=8787
# Interface to bind. 0.0.0.0 is required inside Docker/hosting; use 127.0.0.1 for local-only.
# HOST=0.0.0.0

# Allowed frontend origins, comma-separated, no trailing slash. Unset = any origin (demo only, logs a warning).
# CORS_ORIGINS=https://maqsad.example.com,http://localhost:5173
# Max requests per minute per IP on /api/ai/*. 0 disables.
# RATE_LIMIT_PER_MIN=20
# Proxy hops in front of the app so the rate limit sees the real client IP (Render/Railway: 1). Unset locally.
# TRUST_PROXY=1

# Gemini model (optional)
# GEMINI_MODEL=gemini-3.8-flash
# Tried in order if the main model is busy (503) or rate limited; "none" disables.
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
# Only for tests against a mock Gemini server; leave unset.
# GEMINI_BASE_URL=

# Accounts (sign up / log in). With DATABASE_URL set, users are stored in PostgreSQL (use this in production).
# On Render: copy the database's Internal Database URL into the web service's environment.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Without DATABASE_URL users are saved in AUTH_DATA_DIR/users.json (default ./data, git-ignored) - fine locally,
# but on a host with a throwaway disk the file vanishes on every redeploy/restart.
# AUTH_DATA_DIR=./data
# Secret that signs login tokens. Set a long random string in production; unset = generated into the data dir.
# AUTH_SECRET=
# Max sign-up/login requests per minute per IP. 0 disables.
# AUTH_RATE_LIMIT_PER_MIN=10

# Render free plan: ping this service's own public URL every N minutes so it never spins down (keep under 15).
# Uses RENDER_EXTERNAL_URL (set by Render) unless KEEP_ALIVE_URL is given. Unset = off.
# KEEP_ALIVE_MINUTES=10
